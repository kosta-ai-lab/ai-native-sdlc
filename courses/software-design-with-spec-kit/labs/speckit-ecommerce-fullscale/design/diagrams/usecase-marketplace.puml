@startuml usecase-marketplace
left to right direction
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #EEF3FF
  BorderColor #2b59ff
  ArrowColor #444444
  FontSize 12
}
skinparam actor {
  BackgroundColor #FFF3E0
  BorderColor #E8871E
}
title 멀티셀러 마켓플레이스 — 유스케이스\n<size:11><color:#888>기본 상품·주문·재고 위에 판매자·결제·배송·정산·환불을 얹음</color></size>

actor "구매자" as Buyer
actor "판매자" as Seller
actor "관리자" as Admin
actor "배송사" as Carrier
actor "결제 게이트웨이" as PG
actor "정산 시스템" as Settle
actor "CS 상담원" as CS

rectangle "마켓플레이스 플랫폼" {
  ' --- 구매 여정 ---
  usecase "상품 검색·조회" as UC_Browse
  usecase "장바구니 담기" as UC_Cart
  usecase "주문 생성\n(멀티셀러)" as UC_Order
  usecase "판매자별\n주문 분할" as UC_Split
  usecase "결제 요청" as UC_Pay
  usecase "주문 취소" as UC_Cancel
  usecase "환불 요청" as UC_Refund
  usecase "리뷰 작성" as UC_Review

  ' --- 판매자 ---
  usecase "상품 등록·관리" as UC_Product
  usecase "재고 관리" as UC_Stock
  usecase "주문 확인·수락" as UC_Accept
  usecase "배송 처리" as UC_Ship
  usecase "정산 내역 조회" as UC_SellerSettle

  ' --- 관리자 ---
  usecase "판매자 승인" as UC_Approve
  usecase "수수료 정책 관리" as UC_Fee
  usecase "분쟁 처리" as UC_Dispute

  ' --- 배송 ---
  usecase "배송 접수" as UC_PickUp
  usecase "배송 상태 갱신" as UC_Track

  ' --- 결제/정산 ---
  usecase "결제 승인" as UC_Auth
  usecase "결제 취소·환불" as UC_Void
  usecase "정산 집계" as UC_Aggregate
  usecase "수수료 공제" as UC_Deduct
  usecase "판매자 지급" as UC_Payout

  ' --- CS ---
  usecase "문의 접수" as UC_Inquiry
  usecase "환불 중재" as UC_Mediate
}

' 구매자 연결
Buyer --> UC_Browse
Buyer --> UC_Cart
Buyer --> UC_Order
Buyer --> UC_Cancel
Buyer --> UC_Refund
Buyer --> UC_Review

' 구매 여정 내부 관계
UC_Order ..> UC_Split : <<include>>
UC_Order ..> UC_Pay : <<include>>
UC_Pay ..> UC_Auth : <<include>>
UC_Cancel ..> UC_Void : <<include>>
UC_Refund ..> UC_Void : <<include>>
UC_Refund ..> UC_Mediate : <<extend>>

' 판매자 연결
Seller --> UC_Product
Seller --> UC_Stock
Seller --> UC_Accept
Seller --> UC_Ship
Seller --> UC_SellerSettle
UC_Accept ..> UC_Ship : <<extend>>

' 관리자 연결
Admin --> UC_Approve
Admin --> UC_Fee
Admin --> UC_Dispute
UC_Dispute ..> UC_Mediate : <<include>>

' 배송사 연결
Carrier --> UC_PickUp
Carrier --> UC_Track
UC_Ship ..> UC_PickUp : <<include>>

' 결제 게이트웨이 연결
PG --> UC_Auth
PG --> UC_Void

' 정산 시스템 연결
Settle --> UC_Aggregate
Settle --> UC_Deduct
Settle --> UC_Payout
UC_Aggregate ..> UC_Deduct : <<include>>
UC_Deduct ..> UC_Payout : <<include>>
UC_Ship ..> UC_Aggregate : <<extend>>\n배송완료 시

' CS 연결
CS --> UC_Inquiry
CS --> UC_Mediate

@enduml
